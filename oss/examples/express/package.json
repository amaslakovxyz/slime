{
  "name": "slime-example-express",
  "version": "0.0.0",
  "private": true,
  "description": "An Express app that answers its endpoints with @slime-cloud/core against the demo database.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test 'test/**/*.test.mjs'",
    "crystallize": "node --env-file-if-exists=.env scripts/crystallize.mjs",
    "check:crystal": "slime-crystal check slime-crystal"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@slime-cloud/core": "file:../../packages/core",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
