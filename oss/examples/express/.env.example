# Copy to .env (git ignores it). npm start and npm run crystallize load it.
# A model key makes a real model write handlers; without one, offline-handlers.json does.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# A read-only database user. Default: the demo database (npm run db:up).
DATABASE_URL=
# 1: locked mode (production): serve only saved and Crystal handlers.
SLIME_LOCKED=
SLIME_STORE_DIR=
PORT=
