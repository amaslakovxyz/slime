# Copy to .env (git-ignored) and fill in.

# Claude API key from https://console.anthropic.com -> Settings -> API Keys.
# A Claude.ai Pro/Max subscription does not include API access; the API is billed separately.
ANTHROPIC_API_KEY=

# Read-only demo database from docker compose (npm run db:up). Generated SQL runs as this user.
DATABASE_URL=postgres://slime_reader:slime_reader@localhost:54329/slime
# Where Slime saves Liquid handlers (a separate user owning only the slime_meta schema).
# Leave empty to keep everything in memory.
META_DATABASE_URL=postgres://slime_writer:slime_writer@localhost:54329/slime

# explore = generate code for new requests; locked = only serve existing handlers (misses get 404).
SLIME_MODE=explore

# Who writes handlers: claude, groq, or offline (hand-written handlers from offline/handlers.json; no key needed).
SLIME_PROVIDER=groq
GROQ_API_KEY=

# Generation model and speed settings (see README "Tuning for speed").
SLIME_MODEL=claude-haiku-5-5
SLIME_EFFORT=low
SLIME_THINKING=off

# Background review: a stronger pass checks each new handler before it may become Liquid.
# A rejected handler is regenerated with the reviewer's notes and reviewed again (up to MAX_REVIEWS).
SLIME_REVIEW=on
# SLIME_REVIEW_MODEL defaults to openai/gpt-oss-120b (groq) or claude-opus-5-5 (claude).
SLIME_REVIEW_EFFORT=high
MAX_REVIEWS=2

# Tiers: Gas becomes Liquid after this many SUCCESSFUL runs inside the window AND an approved
# review; otherwise it expires. Liquid handlers are saved and survive restarts.
GAS_TO_LIQUID_HITS=3
GAS_WINDOW_MS=3600000

PORT=3000
