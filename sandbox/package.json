{
  "name": "slime-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slime v0 prototype: one data endpoint, Claude-generated read-only SQL + sandboxed shaping, Gas/Liquid tiers, and a speed/correctness benchmark.",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "bench": "tsx src/bench.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 'test/**/*.test.ts'"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
