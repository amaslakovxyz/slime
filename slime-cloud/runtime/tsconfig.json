{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // The core is consumed from source until sandbox/ becomes the published
    // @slime-cloud/core package; then delete this mapping and add the dependency.
    // esbuild (scripts/build.mjs) and tsx (tests) read the same mapping.
    "paths": {
      "@slime-cloud/core/*": ["../../sandbox/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
