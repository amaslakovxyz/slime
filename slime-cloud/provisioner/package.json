{
  "name": "@slime-cloud/provisioner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slime Cloud provisioner: turns slime-control endpoint items into per-endpoint Lambdas on the Gas layer, and tears them down.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
