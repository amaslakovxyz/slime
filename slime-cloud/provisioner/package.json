  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1173.0",
    "@aws-sdk/client-dynamodb": "^3.1173.0",
    "@aws-sdk/client-iam": "^3.1173.0",
    "@aws-sdk/client-lambda": "^3.1173.0",
    "@aws-sdk/client-ssm": "^3.1173.0",
    "@aws-sdk/lib-dynamodb": "~3.1173.0",
    "@aws-sdk/util-dynamodb": "^3.996.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
