{
  "name": "@slime-cloud/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slime Cloud admin: sign up, create endpoints, see usage and an estimated bill.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v",
    "tables": "node --import tsx scripts/dev-tables.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1174.0",
    "@aws-sdk/client-ssm": "^3.1174.0",
    "@aws-sdk/lib-dynamodb": "^3.1174.0",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/otel": "^2.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
