# The Slime Cloud endpoint (admin → endpoint → Lifecycle shows both), for the two cloud panels.
SLIME_URL=https://<runtime host>/ep/<endpoint id>
SLIME_API_KEY=slm_...
# After Crystallize: the Crystal key (the Hash column) and its slc_ token. Optional;
# without them the panel keeps calling POST /v0/query.
CRYSTAL_PLAN_REVENUE_KEY=
CRYSTAL_PLAN_REVENUE_TOKEN=
CRYSTAL_CHURN_RISK_KEY=
CRYSTAL_CHURN_RISK_TOKEN=
# The self-hosted examples/multi-source server, for the Customer 360 panel; `off` disables that panel.
MULTI_SOURCE_URL=http://localhost:3000
PORT=4000
