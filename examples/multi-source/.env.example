# Copy to .env (git ignores it). npm start loads it.
# A model key makes a real model write handlers; without one, offline-handlers.json does.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# A read-only database user. Default: the demo database (cd ../express && npm run db:up).
DATABASE_URL=
# The "Slime reader" integration: Read content only.
NOTION_TOKEN=
NOTION_FEEDBACK_ID=
NOTION_MOVIE_NIGHTS_ID=
# Only for scripts/seed-notion.mjs: the "Slime seeder" integration (Insert content).
NOTION_SEED_TOKEN=
NOTION_PARENT_PAGE_ID=
PORT=
