# examples/multi-source/.env — local only, git ignores it. Fill the empty values below.
#
# Notion setup (once):
#   1. In Notion, create a page, for example "Slime demo".
#   2. Open https://www.notion.so/profile/integrations and create two INTERNAL integrations
#      in that workspace:
#        - "Slime reader": Capabilities -> only "Read content" (untick Update/Insert).
#        - "Slime seeder": Capabilities -> "Read content" and "Insert content".
#   3. Open the page -> ... menu -> Connections -> add BOTH integrations.
#   4. Copy each integration's "Internal Integration Secret" below (starts with ntn_).
#   5. The page id is the 32 hex characters at the end of the page URL,
#      e.g. https://www.notion.so/Slime-demo-1f2e3d4c5b6a47898abcdef012345678 -> 1f2e3d4c5b6a47898abcdef012345678

# Slime reads with this token (the "Slime reader" integration).
NOTION_TOKEN=
# Used only by "npm run notion:seed" to create the demo data ("Slime seeder").
NOTION_SEED_TOKEN=
NOTION_PARENT_PAGE_ID=

# Filled by "npm run notion:seed" (it prints both lines); leave empty until then.
NOTION_FEEDBACK_ID=
NOTION_MOVIE_NIGHTS_ID=

# Required for npm start and the live run: the model that writes handlers.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Default: the demo database (cd ../express && npm run db:up).
DATABASE_URL=
PORT=
