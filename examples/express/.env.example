# Copy to .env (git ignores it). npm start and npm run crystallize load it.
# Required for npm start: the model that writes a handler for each new request.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# A read-only database user. Default: the demo database (npm run db:up).
DATABASE_URL=
# 1: add POST /dev/query, which answers any request. Local development only.
SLIME_DEV_QUERY=
SLIME_STORE_DIR=
PORT=
