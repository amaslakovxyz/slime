{
  "name": "@slime-cloud/crystal",
  "version": "0.0.0",
  "private": true,
  "description": "Crystallize proven Slime handlers into reviewed code in your repo: the crystallize job, typed service methods, and the slime-crystal CLI (check, pin, verify).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "slime-crystal": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "check:pack": "node scripts/check-pack.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5"
  },
  "peerDependencies": {
    "@slime-cloud/core": "0.0.0",
    "pg": "^8.23.1"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@slime-cloud/core": "0.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
