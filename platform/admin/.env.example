SESSION_SECRET=change-me-to-32+-random-characters-local-only
AWS_REGION=eu-central-1
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
SLIME_CONTROL_TABLE=slime-control
SLIME_SECRETS=file
SLIME_SECRETS_FILE=.data/secrets.json
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Invite-only sign-up: comma-separated emails (unset = open, as locally). The hosted
# admin reads it from SSM /slime/admin/ADMIN_ALLOWED_EMAILS.
# ADMIN_ALLOWED_EMAILS=you@example.com
