{
  "name": "@slime-cloud/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slime Cloud runtime: @slime-cloud/core on AWS Lambda with a DynamoDB handler store.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "migrate": "node --import tsx src/migrate-cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-dynamodb": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/client-ssm": "^3.1173.0",
    "@aws-sdk/lib-dynamodb": "~3.1173.0",
    "@slime-cloud/core": "file:../../core",
    "hono": "^4.13.19",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
